#!/usr/bin/env bash
# ============================================================================
# Git pre-push hook: блокирует push, если локальный мини-CI не прошёл.
#
# Подключение (один раз):
#   git config core.hooksPath .githooks
#
# Отключить на один push:  git push --no-verify
# ============================================================================
echo "pre-push: запуск локального мини-CI (ci-local.sh)..."
./ci-local.sh || {
  echo
  echo "pre-push: ПРОВАЛ. Пуш отменён."
  echo "  - исправьте ошибки и повторите git push;"
  echo "  - для обхода (не рекомендуется): git push --no-verify"
  exit 1
}
