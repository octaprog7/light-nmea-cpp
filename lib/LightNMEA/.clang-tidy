# LightNMEA clang-tidy configuration
# Запуск: clang-tidy -p build/compile_commands.json <file>

Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-else-after-return,
  -readability-isolate-declaration

WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file
